{
  "appId": "com.electron.notes",
  "productName": "Essential Note",
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*",
    "dist/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "./build/BYZ.ico",
    "certificateFile": "./build/note-test-certificate.pfx",
    "certificatePassword": "YourPassword"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "build"
  },
  "mac": {
    "identity": null,
    "target": [
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "./build/icon.icns",
    "category": "public.app-category.productivity"
  },
  "dmg": {
    "sign": false,
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
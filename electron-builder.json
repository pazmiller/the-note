{
  "appId": "com.electron.notes",
  "productName": "Essential Note",
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*",
    "dist/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "./build/BYZ.ico",
    "certificateFile": "./build/note-test-certificate.pfx",
    "certificatePassword": "YourPassword"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "build"
  }
}